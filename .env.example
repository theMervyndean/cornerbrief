# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Enterprise HMAC-SHA256 signing secret for CornerBrief session tokens.
# Must be set to a high-entropy secret string in production deployments.
SESSION_SECRET="cornerbrief_enterprise_session_secret_2026_scrypt_hmac"

# NOTIFICATION SYSTEM CONFIGURATION
# Platform Admin Notification Destinations
PLATFORM_ADMIN_WHATSAPP="+2348141880550"
PLATFORM_ADMIN_EMAIL="thecornerstreams@gmail.com"

# WhatsApp Business Integration Settings
# Supports 'meta' (Meta Cloud API) or 'twilio'
WHATSAPP_PROVIDER="meta"
# For Meta WhatsApp Business Cloud API:
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# For Twilio WhatsApp (Alternative Provider):
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="+14155238886"

# Gmail Delivery Settings (SMTP / Gmail App Password or Service Relay)
GMAIL_USER="thecornerstreams@gmail.com"
GMAIL_APP_PASSWORD=""
GMAIL_SENDER_NAME="CornerBrief Healthcare Network"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
